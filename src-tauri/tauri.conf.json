{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DoraBase",
  "version": "../package.json",
  "identifier": "com.dorabase.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm proxy:embarquer && pnpm dev",
    "beforeBuildCommand": "pnpm proxy:embarquer && pnpm build",
    "beforeBundleCommand": "bash scripts/fondre-binaires-universels.sh"
  },
  "app": {
    "windows": [
      {
        "title": "DoraBase",
        "width": 1360,
        "height": 814,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "zoomHotkeysEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ipc://localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/cloud-sql-proxy"],
    "resources": ["licences/cloud-sql-proxy/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/fond-dmg.tiff",
        "windowSize": { "width": 660, "height": 472 },
        "appPosition": { "x": 168, "y": 233 },
        "applicationFolderPosition": { "x": 492, "y": 233 }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDNEUwRUFGNEM2RjMyREQKUldUZE1tOU1ydzVPSEh2cE5oVEgxb3FSd1ZSZG1INzJxYVY5NmtPaWFJSHVVUks5QUl6MVkxR1EK",
      "endpoints": ["https://github.com/g3wis/DoraBase/releases/latest/download/latest.json"]
    }
  }
}
